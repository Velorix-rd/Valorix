{
  "name": "velorix",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "tsx scripts/generate-sitemap.ts && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:pages": "tsx scripts/generate-sitemap.ts && vite build",
    "sitemap:generate": "tsx scripts/generate-sitemap.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "capacitor:install": "npm install @capacitor/core @capacitor/cli @capacitor/android @capacitor/app @capacitor/filesystem --save",
    "capacitor:init": "npx cap init --web-dir dist",
    "capacitor:add-android": "npx cap add android",
    "capacitor:build": "npm run build && npx cap copy && npx cap sync",
    "capacitor:open": "npx cap open android",
    "capacitor:sync": "npx cap sync",
    "build:apk": "npm run build && npm run capacitor:build"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@google/genai": "^2.22.0",
    "@tailwindcss/vite": "^4.0.0",
    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.4.0",
    "fs-extra": "^11.2.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
